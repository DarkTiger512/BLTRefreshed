{$BLT_HOSTNAME} {
	encode zstd gzip
	handle /privacy {
		rewrite * /privacy.html
		root * /srv/blt-public
		file_server
	}
	handle /privacy.html {
		root * /srv/blt-public
		file_server
	}
	handle {
		reverse_proxy service:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
