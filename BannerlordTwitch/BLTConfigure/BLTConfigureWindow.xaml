<Window x:Class="BLTConfigure.BLTConfigureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BLT Twitch Connection" Width="640" Height="720" MinWidth="520" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#101C25" Foreground="#ECF2F3">
  <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="0,8,8,0"/><Setter Property="Padding" Value="16,9"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30">
    <TextBlock Text="BLT TWITCH INTEGRATION" Foreground="#DDB85E" FontWeight="Bold" FontSize="12"/><TextBlock Text="Connect your game" FontSize="30" FontWeight="Bold" Margin="0,5,0,6"/><TextBlock Text="Authorize the broadcaster account, then pair this installation using the one-time code from your Twitch Extension settings." Foreground="#AFC0C7" FontSize="14"/>
    <Border Background="#172B37" BorderBrush="#38505D" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,24,0,12"><StackPanel><TextBlock Text="1. Twitch broadcaster authorization" Foreground="#F1CB76" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="BroadcasterStatus" Text="Checking authorization…" Margin="0,8,0,4"/><StackPanel Orientation="Horizontal"><Button x:Name="GenerateTokenButton" Content="Authorize broadcaster" Click="GenerateToken_OnClick"/><Button x:Name="GenerateTokenCancel" Content="Cancel" Visibility="Collapsed" Click="CancelAuth_OnClick"/></StackPanel></StackPanel></Border>
    <Border Background="#172B37" BorderBrush="#38505D" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="2. Pair this installation" Foreground="#F1CB76" FontSize="18" FontWeight="Bold"/><TextBlock Text="Generate a code in Twitch Config, paste it here, and press Pair. Pairing never starts automatically." Foreground="#AFC0C7" Margin="0,8,0,12"/><TextBox x:Name="PairingCodeTextBox" FontFamily="Consolas" FontSize="18" CharacterCasing="Upper" Padding="12,9" MaxLength="13" TextChanged="PairingCode_OnTextChanged"/><StackPanel Orientation="Horizontal"><Button x:Name="PairButton" Content="Pair" Click="Pair_OnClick"/><Button x:Name="CancelPairingButton" Content="Cancel request" Visibility="Collapsed" Click="CancelPairing_OnClick"/><Button x:Name="RepairButton" Content="Re-pair" Visibility="Collapsed" Click="Repair_OnClick"/></StackPanel><Border Background="#10202A" CornerRadius="6" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="PairingStateTitle" Text="Not paired" FontWeight="Bold"/><TextBlock x:Name="PairingStateDetail" Text="Waiting for a code." Foreground="#AFC0C7" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border>
    <Expander Header="Advanced: use a separate bot account" Foreground="#CAD7DB" Margin="0,4,0,0"><Border Background="#172B37" BorderBrush="#38505D" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="BotStatus" Text="The broadcaster account is used for chat by default." Foreground="#AFC0C7"/><StackPanel Orientation="Horizontal"><Button x:Name="GenerateBotTokenButton" Content="Authorize bot account" Click="GenerateBotToken_OnClick"/><Button x:Name="GenerateBotTokenCancel" Content="Cancel" Visibility="Collapsed" Click="CancelAuth_OnClick"/><Button x:Name="UseMainAccountForBotButton" Content="Use broadcaster account" Click="UseMainAccountForBot_OnClick"/></StackPanel></StackPanel></Border></Expander>
  </StackPanel></ScrollViewer>
</Window>
